PORT=5000
NODE_ENV=development

# Database Dialect: 'sqlite' or 'mysql'
DB_DIALECT=sqlite
SQLITE_DB_PATH=./taxpal.sqlite

# MySQL Connection (if DB_DIALECT=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=taxpal

# JWT Authentication
JWT_SECRET=taxpal_super_secure_jwt_access_secret_key_2026
JWT_EXPIRES=15m
REFRESH_SECRET=taxpal_super_secure_jwt_refresh_secret_key_2026
REFRESH_EXPIRES=7d

# Optional AI & Mailer Configurations
GEMINI_API_KEY=
OPENAI_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
